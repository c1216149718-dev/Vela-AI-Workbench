<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vela.Starting" parent="Theme.SplashScreen">
        <item name="android:windowFullscreen">true</item>
        <item name="windowSplashScreenBackground">#121D29</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/vela_splash_transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.DeepSeekWidget</item>
    </style>

    <style name="Theme.DeepSeekWidget" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/deepseek_blue</item>
        <item name="colorPrimaryVariant">@color/deepseek_blue_dark</item>
        <item name="colorOnPrimary">@color/on_hero</item>
        <item name="colorSecondary">@color/apikey_amber</item>
        <item name="colorOnSecondary">@color/on_hero</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/surface_background</item>
        <item name="colorOnSurface">@color/balance_text</item>
        <item name="colorError">@color/accent_red</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
