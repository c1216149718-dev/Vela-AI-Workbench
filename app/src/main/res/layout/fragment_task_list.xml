<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="serif"
                android:text="@string/tasks_title"
                android:textColor="@color/balance_text"
                android:textSize="21sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/search_tasks"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/workbench_input_background"
            android:hint="@string/tasks_search_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/balance_text"
            android:textColorHint="@color/muted_text"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/filter_group"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_today"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:text="@string/tasks_filter_today"
                android:textColor="@color/usage_range_text"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_planned"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:text="@string/tasks_filter_planned"
                android:textColor="@color/usage_range_text"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_all"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:text="@string/tasks_filter_all"
                android:textColor="@color/usage_range_text"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_completed"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:text="@string/tasks_filter_completed"
                android:textColor="@color/usage_range_text"
                android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/task_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="132dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/tasks_empty"
                android:textColor="@color/muted_text"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="116dp"
        android:contentDescription="@string/tasks_new"
        android:src="@drawable/ic_module_plan"
        app:backgroundTint="@color/deepseek_blue"
        app:tint="@color/on_hero" />
</FrameLayout>
