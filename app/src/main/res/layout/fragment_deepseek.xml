<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/deepseek_blur_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/provider_detail_backdrop" />
    </eightbitlab.com.blurview.BlurTarget>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="44dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_deepseek_back"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/action_back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/balance_text" />

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/provider_icon_glass"
                    android:padding="9dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/deepseek_account"
                        android:scaleType="fitCenter"
                        android:src="@drawable/provider_deepseek" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="@string/deepseek_account"
                        android:textColor="@color/balance_text"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/deepseek_page_subtitle"
                        android:textColor="@color/muted_text"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/deepseek_balance_glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/provider_glass_card"
                android:clipToOutline="true"
                app:blurOverlayColor="@color/provider_glass_overlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/current_balance"
                        android:textColor="@color/muted_text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/deepseek_balance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/placeholder_value"
                        android:textColor="@color/balance_text"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/hero_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/granted_label"
                                android:textColor="@color/muted_text"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/deepseek_granted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:text="@string/granted_balance_empty"
                                android:textColor="@color/balance_text"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/topped_up_label"
                                android:textColor="@color/muted_text"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/deepseek_topped_up"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:text="@string/topped_up_balance_empty"
                                android:textColor="@color/balance_text"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/updated_label"
                                android:textColor="@color/muted_text"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/deepseek_updated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:text="@string/placeholder_value"
                                android:textColor="@color/balance_text"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/deepseek_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/chip_status_background"
                        android:paddingStart="11dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="4dp"
                        android:text="@string/not_configured"
                        android:textColor="@color/accent_green"
                        android:textSize="11sp" />
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/deepseek_key_glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/provider_glass_card"
                android:clipToOutline="true"
                app:blurOverlayColor="@color/provider_glass_overlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/api_key"
                            android:textColor="@color/balance_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/key_config_subtitle"
                            android:textColor="@color/muted_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/deepseek_api_key_hint"
                        app:boxBackgroundColor="@color/surface_inner"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/deepseek_blue"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:endIconMode="clear_text"
                        app:hintTextColor="@color/muted_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_deepseek_api_key"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text|textNoSuggestions"
                            android:singleLine="true"
                            android:textColor="@color/balance_text"
                            android:textColorHint="@color/muted_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_test_deepseek"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/glass_button_background"
                        android:text="@string/test_connection"
                        android:textAllCaps="false"
                        android:textColor="@color/deepseek_blue"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/deepseek_connection_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/label_text"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/deepseek_usage_glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/provider_glass_card"
                android:clipToOutline="true"
                app:blurOverlayColor="@color/provider_glass_overlay">

                <com.deepseek.widget.ui.UsageDashboardView
                    android:id="@+id/deepseek_dashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </eightbitlab.com.blurview.BlurView>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
