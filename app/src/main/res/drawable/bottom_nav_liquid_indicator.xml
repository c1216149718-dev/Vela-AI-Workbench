<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bottom_nav_indicator_fill" />
            <corners android:radius="19dp" />
            <stroke
                android:width="1dp"
                android:color="@color/bottom_nav_indicator_border" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="34dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2EFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
