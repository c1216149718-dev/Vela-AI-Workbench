<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_background" />
        </shape>
    </item>
    <item android:top="-120dp" android:bottom="300dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/surface_elevated"
                android:centerColor="@color/app_background"
                android:endColor="@color/surface_inner" />
        </shape>
    </item>
</layer-list>
